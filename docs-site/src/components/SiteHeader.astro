---
import { repositoryUrl, withBase } from '../lib/site';
import Search from './Search.astro';

---

<header class="site-header">
	<div class="site-header__inner">
		<a class="site-header__brand" href={withBase('/')} aria-label="Kanban home">Kanban</a>
		<Search class="site-header__search" />
		<div class="site-header__actions">
			<a class="site-header__github" href={repositoryUrl} aria-label="View Kanban on GitHub">
				<svg aria-hidden="true" viewBox="0 0 24 24">
					<path d="M12 2a10 10 0 0 0-3.16 19.49c.5.09.68-.22.68-.48v-1.87c-2.78.6-3.37-1.18-3.37-1.18-.45-1.16-1.11-1.47-1.11-1.47-.91-.62.07-.61.07-.61 1 .07 1.53 1.03 1.53 1.03.9 1.53 2.35 1.09 2.92.83.09-.65.35-1.09.64-1.34-2.22-.25-4.55-1.11-4.55-4.94 0-1.09.39-1.98 1.03-2.68-.1-.25-.45-1.27.1-2.64 0 0 .84-.27 2.75 1.02A9.56 9.56 0 0 1 12 6.82c.85 0 1.71.12 2.51.34 1.91-1.29 2.75-1.02 2.75-1.02.55 1.37.2 2.39.1 2.64.64.7 1.03 1.59 1.03 2.68 0 3.84-2.34 4.68-4.57 4.93.36.31.68.92.68 1.85v2.77c0 .27.18.58.69.48A10 10 0 0 0 12 2Z"></path>
				</svg>
			</a>
			<span class="site-header__divider" aria-hidden="true"></span>
			<span class="site-header__theme" aria-label="Dark theme">
				<svg aria-hidden="true" viewBox="0 0 24 24">
					<path d="M21 12.8A8.5 8.5 0 1 1 11.2 3 6.6 6.6 0 0 0 21 12.8Z"></path>
				</svg>
				<span>Dark</span>
			</span>
		</div>
	</div>
</header>
